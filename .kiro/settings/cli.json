{
  "app.launchOnStartup": false,
  "autocomplete.disable": true,
  "chat.defaultAgent": "yolo",
  "chat.disableTrustAllConfirmation": true,
  "chat.enableAutoAgentUpgrade": true,
  "chat.showThinking": "collapsed",
  "chat.statusLine.tui": {
    "usage": true
  },
  "chat.verbosity.tui": {
    "display": {
      "argsMaxChars": null,
      "argsMaxLines": null,
      "outputMaxChars": null,
      "outputMaxLines": 5,
      "persistOutput": false,
      "showElapsed": false,
      "showTasks": true,
      "showThinkingContent": true,
      "showToolReasoning": false,
      "showWriteDiffs": true,
      "subagent": {
        "deps": false,
        "pipeline": false,
        "prompts": false,
        "responses": false,
        "roles": false
      },
      "thinkingDisplay": "collapsed",
      "toolArgsMode": "block"
    },
    "filters": [
      "all",
      "-subagent"
    ]
  }
}