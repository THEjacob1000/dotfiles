# nix-direnv: prefer the nix-profile copy (Linux/nix installs), fall back to the pinned upstream
# release; skipped without nix, since `use flake` can't work there anyway.
if [ -e "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]; then
    source "$HOME/.nix-profile/share/nix-direnv/direnvrc"
elif has nix; then
    source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" \
        "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi
