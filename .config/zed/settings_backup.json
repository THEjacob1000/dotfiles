// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"context_servers": {
		"bun-docs-mcp": {
			"enabled": true,
			"settings": {}
		},
		"airis-mcp-gateway": {
			"enabled": true,
			"command": "bunx",
			"args": ["-y", "mcp-remote", "http://localhost:9400/sse"]
		},
		"mcp-server-buildkite": {
			"enabled": true,
			"settings": {
				"buildkite_api_token": "***REDACTED_BUILDKITE_TOKEN***"
			}
		}
	},
	"agent": {
		"tool_permissions": {
			"default": "allow"
		},
		"default_model": {
			"provider": "openai",
			"model": "gpt-5"
		}
	},
	"vim_mode": false,
	"icon_theme": {
		"mode": "dark",
		"light": "VSCode Icons",
		"dark": "VSCode Icons"
	},
	"ui_font_size": 16,
	"buffer_font_size": 15,
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "Tokyo Night"
	},
	"file_types": {
		"Shell Script": ["conf", ".dev.vars"],
		"bazelrc": [".bazelrc.*"]
	},
	"languages": {
		"TypeScript": {
			"format_on_save": "on"
		},
		"TSX": {
			"format_on_save": "on"
		},
		"JSON": {
			"format_on_save": "on"
		},
		"JSONC": {
			"format_on_save": "on"
		}
	},
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				},
				"javascript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				}
			},
			"enable_lsp_tasks": true
		},
		"dart": {
			"binary": {
				"path": "/Users/jacob/.local/share/mise/installs/flutter/3.38.5-stable/bin/dart",
				"arguments": ["language-server", "--protocol=lsp"]
			}
		}
	},
	"terminal": {
		"detect_venv": {
			"on": {
				// Default directories to search for virtual environments, relative
				// to the current working directory. We recommend overriding this
				// in your project's settings, rather than globally.
				"directories": [".env", "env", ".venv", "venv"],
				// Can also be `csh`, `fish`, and `nushell`
				"activate_script": "default"
			}
		}
	}
}
