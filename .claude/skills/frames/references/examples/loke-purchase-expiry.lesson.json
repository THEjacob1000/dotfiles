{
  "schema_version": 2,
  "lesson_id": "loke:purchase-expiry",
  "title": "When an unaccepted purchase expires, what changes atomically, and why is a reversal not proof of an external refund?",
  "objectives": [
    {
      "id": "trace",
      "outcome": "Trace candidate selection through the locked eligibility recheck and domain transition, including acceptance exactly at the deadline.",
      "concept_ids": [
        "loke:eligibility",
        "loke:domain"
      ],
      "check_ids": [
        "acceptance-at-deadline"
      ]
    },
    {
      "id": "boundary",
      "outcome": "Explain which internal writes share the SQL transaction and distinguish Pending refund recording from external refund completion.",
      "concept_ids": [
        "loke:transaction"
      ],
      "check_ids": [
        "refund-boundary"
      ]
    },
    {
      "id": "duplicate",
      "outcome": "Predict why a second worker with a new reference does not count a rejection committed by the first.",
      "concept_ids": [
        "loke:retries"
      ],
      "check_ids": [
        "predict-duplicate"
      ]
    }
  ],
  "prerequisites": [
    {
      "concept_id": "database:transaction",
      "explanation": "A transaction groups database writes so its commit exposes one result. It does not by itself complete an external payment-provider operation."
    },
    {
      "concept_id": "database:row-lock",
      "explanation": "A locked reload waits for conflicting writers of the same row. Here the purchase is re-read under FOR UPDATE before the eligibility decision."
    }
  ],
