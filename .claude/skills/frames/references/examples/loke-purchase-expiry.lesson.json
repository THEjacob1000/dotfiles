  "steps": [
    {
      "id": "find-due",
      "concept_id": "loke:eligibility",
      "objective_ids": [
        "trace"
      ],
      "question": "Which purchases are candidates, rather than guaranteed mutations?",
      "scene_id": "orientation",
      "beats": [
        {
          "id": "orient",
          "narration": "The worker coordinates a concrete PurchaseStore. Records loads and updates the purchase row; Sale owns the eligibility and rejection rules. The coordinator also persists applicable wallet, points and discount effects. These are internal and conditional, not additional workers.",
          "claim_ids": [
            "concrete-boundary",
            "atomic-writes"
          ],
          "actions": [
            {
              "kind": "show",
              "targets": [
                "worker",
                "store",
                "records",
                "row",
                "sale",
                "saved",
                "wallet",
                "points"
              ],
              "offset_ms": 0,
              "duration_ms": 600
            },
            {"kind": "focus", "targets": ["records"], "offset_ms": 5000, "duration_ms": 1000},
            {"kind": "focus", "targets": ["sale"], "offset_ms": 10000, "duration_ms": 1000},
            {"kind": "focus", "targets": ["wallet", "points"], "offset_ms": 14500, "duration_ms": 1000}
          ],
          "duration_ms": 18000
        },
        {
          "id": "scan-page",
          "narration": "Selecting a due purchase is not permission to reject its old state. The tenant-scoped scan reads up to 100 rows ordered by deadline and purchase ID. Its exclusive cursor advances pages; each selected purchase gets its own expiry attempt.",
          "claim_ids": [
            "paged-scan",
            "locked-reload"
          ],
          "actions": [
            {
              "kind": "focus",
              "targets": [
                "worker",
                "records",
                "saved"
              ],
              "offset_ms": 0,
              "duration_ms": 600
            },
            {"kind": "annotate", "targets": ["records"], "offset_ms": 5000, "duration_ms": 1000, "text": "tenant + deadline <= now; ordered cursor page"},
            {"kind": "focus", "targets": ["worker", "store"], "offset_ms": 12500, "duration_ms": 1000}
          ],
          "duration_ms": 18000
        }
      ]
    },
    {
      "id": "locked-reload",
      "concept_id": "loke:transaction",
      "objective_ids": [
        "trace",
        "boundary"
      ],
      "question": "Where does the selected purchase become protected from a competing mutation?",
      "scene_id": "expiry-sequence",
      "beats": [
        {
          "id": "enter",
          "narration": "The store starts READ COMMITTED and reloads the purchase exclusively. records::load implements that flag with SELECT FOR UPDATE on the organisation and purchase row. Holding the lock protects the eligibility decision and subsequent writes from a competing acceptance. The tradeoff is waiting: workers and acceptance queue behind a conflicting row lock rather than using SKIP LOCKED.",
          "claim_ids": [
            "locked-reload",
            "race-tests"
          ],
          "actions": [
            {
              "kind": "call",
              "targets": [
                "store",
                "tx"
              ],
              "offset_ms": 0,
              "duration_ms": 600,
              "source": "store",
              "destination": "tx",
              "label": "BEGIN READ COMMITTED"
            },
            {
              "kind": "acquire",
              "targets": [
                "tx",
                "row"
              ],
              "offset_ms": 1000,
              "duration_ms": 600,
              "resource": "row",
              "transaction": "tx"
            },
            {"kind": "focus", "targets": ["row"], "offset_ms": 6500, "duration_ms": 1000},
            {"kind": "annotate", "targets": ["row"], "offset_ms": 12500, "duration_ms": 1000, "text": "conflicting writer waits until transaction ends"}
          ],
          "duration_ms": 18000
        }
      ]
    },
    {
      "id": "recheck",
      "concept_id": "loke:eligibility",
      "objective_ids": [
        "trace"
      ],
      "question": "Why can a row selected by the scan still produce no change?",
      "scene_id": "expiry-sequence",
      "beats": [
        {
          "id": "still-due",
          "narration": "The decision uses the reloaded Sale, not the scanned projection. Still AwaitingAcceptance with an explicit deadline at or before now means auto_reject is true. Only that branch reaches rejection. The predicate inspects state; it does not advance it.",
          "claim_ids": [
            "recheck",
            "inclusive-deadline"
          ],
          "actions": [
            {
              "kind": "call",
              "targets": [
                "store",
                "sale"
              ],
              "offset_ms": 0,
              "duration_ms": 600,
              "source": "store",
              "destination": "sale",
              "label": "due_work(now).auto_reject"
            },
            {"kind": "annotate", "targets": ["sale"], "offset_ms": 5500, "duration_ms": 1000, "text": "AwaitingAcceptance + explicit deadline <= now"},
            {"kind": "focus", "targets": ["store"], "offset_ms": 13000, "duration_ms": 1000}
          ],
          "duration_ms": 18000
        },
        {
          "id": "no-longer-due",
          "narration": "Compare an accepted or already rejected snapshot: auto_reject is false. reverse_locked commits unchanged and returns that snapshot before taking the reversal path. This is why selection alone cannot decide the mutation.",
          "claim_ids": [
            "recheck",
            "inclusive-deadline"
          ],
          "actions": [
            {
              "kind": "annotate",
              "targets": [
                "sale"
              ],
              "offset_ms": 0,
              "duration_ms": 600,
              "text": "still due → transition | no longer eligible → commit unchanged"
            },
            {"kind": "focus", "targets": ["sale"], "offset_ms": 5000, "duration_ms": 1000},
            {"kind": "annotate", "targets": ["tx"], "offset_ms": 12500, "duration_ms": 1000, "text": "no longer due: return unchanged, no reversal writes"}
          ],
          "duration_ms": 18000
        },
        {
          "id": "deadline-transfer",
          "narration": "Now transfer the eligibility rule to acceptance. Sale::check_progress asks due_work(now).auto_reject before first acceptance. At exactly the deadline, now >= deadline is already true for a still-awaiting timed order, so acceptance is refused even if no expiry worker has run. A separate source test asserts refusal at times 10 and 11 without prior expiry or writes; it was inspected, not executed here.",
          "claim_ids": ["deadline-acceptance"],
          "actions": [
            {
              "kind": "annotate",
              "targets": ["sale"],
              "offset_ms": 0,
              "duration_ms": 600,
              "text": "still AwaitingAcceptance + now >= deadline → first acceptance refused"
            },
            {"kind": "focus", "targets": ["sale"], "offset_ms": 6500, "duration_ms": 1000},
            {"kind": "annotate", "targets": ["sale"], "offset_ms": 13000, "duration_ms": 1000, "text": "check_progress refuses first acceptance; worker need not run"}
          ],
          "duration_ms": 18000
        }
      ],
      "check": {
        "id": "acceptance-at-deadline",
        "placement": "after",
        "prompt": "Judge the claim for an order still AwaitingAcceptance: first acceptance at exactly its explicit deadline can succeed if expiry has not run yet. Explain using Sale::check_progress and Sale::due_work.",
        "objective_ids": ["trace"],
        "explanation": "The admission rule does not wait for expiry: check_progress asks due_work(now).auto_reject, which is true at equality.",
        "reveal_target": {"kind": "beat", "beat_id": "deadline-transfer"},
        "answer": {
          "kind": "free_text",
          "reference_answer": "False. At equality the due predicate is already true for a still-awaiting timed order, so first acceptance is refused before any expiry worker records rejection."
        }
      }
    },
    {
      "id": "domain",
      "concept_id": "loke:domain",
      "objective_ids": [
        "trace",
        "boundary"
      ],
      "question": "Which domain state changes, and is the card refund completed?",
      "scene_id": "sale-states",
      "beats": [
        {
          "id": "reject-domain",
          "narration": "reject_expired checks the deadline again for a first rejection, then records the deadline cause and accountable owner. reject_with records rejection, runs reverse, and sets fulfilment to Rejected. The reversal records its reference and original benefit effects; optional updated wallet and points snapshots are returned for persistence.",
          "claim_ids": [
            "rejection",
            "reversal-effects"
          ],
          "actions": [
            {
              "kind": "set_state",
              "targets": [
                "sale"
              ],
              "offset_ms": 0,
              "duration_ms": 600,
              "property": "fulfilment",
              "before": "AwaitingAcceptance",
              "after": "Rejected"
            },
            {"kind": "annotate", "targets": ["sale"], "offset_ms": 6500, "duration_ms": 1000, "text": "deadline cause; owner and reference recorded"},
            {"kind": "focus", "targets": ["sale"], "offset_ms": 13500, "duration_ms": 1000}
          ],
          "duration_ms": 18000
        },
        {
          "id": "refund-request",
          "narration": "If card money remains, reverse creates a refund request with status Pending and no resolution time. The reversal stores that request, not proof that a payment provider completed it. No external refund worker or transport is part of this depicted call path.",
          "claim_ids": [
            "pending-not-paid"
          ],
          "actions": [
            {
              "kind": "annotate",
              "targets": [
                "sale"
              ],
              "offset_ms": 0,
              "duration_ms": 600,
              "text": "Pending refund recorded ≠ external refund executed"
            },
            {"kind": "annotate", "targets": ["sale"], "offset_ms": 6500, "duration_ms": 1000, "text": "remaining card amount → optional Pending request"},
            {"kind": "annotate", "targets": ["sale"], "offset_ms": 13500, "duration_ms": 1000, "text": "resolved_at: None; no provider completion established"}
          ],
          "duration_ms": 18000
        }
      ],
      "check": {
        "id": "refund-boundary",
        "placement": "after",
        "prompt": "Judge the claim: recording a reversal containing a refund proves the external card refund completed. Name what was actually recorded and what remains unproven.",
        "objective_ids": ["boundary"],
        "explanation": "The domain records a Pending request with no resolution time, not a provider-completion result.",
        "reveal_target": {"kind": "beat", "beat_id": "refund-request"},
        "answer": {
          "kind": "free_text",
          "reference_answer": "False. The sale contains a Pending refund request. Recording that request does not establish external execution or provider completion."
        }
      }
    },
    {
      "id": "commit",
      "concept_id": "loke:transaction",
      "objective_ids": [
        "boundary"
      ],
      "question": "What does this commit make atomic, and what does it not establish?",
      "scene_id": "expiry-sequence",
      "beats": [
        {
          "id": "persist-effects",
          "narration": "After admission and validation, the coordinator obtains applicable wallet and points locks, applies the domain transition, releases consumed discounts and writes applicable wallet and points changes. records::update writes the sale snapshot, version and deadline/queue projections through that same transaction.",
          "claim_ids": [
            "atomic-writes"
          ],
          "actions": [
            {
              "kind": "focus",
              "targets": [
                "tx",
                "wallet",
                "points",
                "saved"
              ],
              "offset_ms": 0,
              "duration_ms": 600
            },
            {"kind": "focus", "targets": ["wallet", "points"], "offset_ms": 4500, "duration_ms": 1000},
            {"kind": "focus", "targets": ["saved"], "offset_ms": 10000, "duration_ms": 1000},
            {"kind": "annotate", "targets": ["tx"], "offset_ms": 14500, "duration_ms": 1000, "text": "same SQL transaction: applicable effects + snapshot + projections"}
          ],
          "duration_ms": 18000
        },
        {
          "id": "commit-boundary",
          "narration": "The SQL commit makes those internal writes one committed result. No-op branches also commit without writes. A stored Pending refund remains a request; this commit does not establish external card-refund completion.",
          "claim_ids": [
            "atomic-writes",
            "pending-not-paid"
          ],
          "actions": [
            {
              "kind": "commit",
              "targets": [
                "tx"
              ],
              "offset_ms": 0,
              "duration_ms": 600,
              "transaction": "tx"
            },
            {"kind": "focus", "targets": ["saved"], "offset_ms": 5500, "duration_ms": 1000},
            {"kind": "annotate", "targets": ["saved"], "offset_ms": 12500, "duration_ms": 1000, "text": "committed Pending request ≠ completed external refund"}
          ],
          "duration_ms": 18000
        }
      ]
    },
    {
      "id": "retry-transfer",
      "concept_id": "loke:retries",
      "objective_ids": [
        "duplicate",
        "trace"
      ],
      "question": "Does a second expiry reference mean a second newly expired purchase?",
      "scene_id": "duplicate-sequence",
      "beats": [
        {
          "id": "retry-setup",
          "narration": "Each expire_one attempt generates its own random reference. Its result counts only if the returned reversal reference matches that attempt. We can now apply the locked reload and recheck to a second attempt, rather than treating any existing reversal as its success.",
          "claim_ids": [
            "attempt-attribution"
          ],
          "actions": [
            {
              "kind": "show",
              "targets": [
                "worker",
                "second",
                "tx",
                "row",
                "sale"
              ],
              "offset_ms": 0,
              "duration_ms": 600
            },
            {"kind": "annotate", "targets": ["worker"], "offset_ms": 5500, "duration_ms": 1000, "text": "each expire_one creates its own attempt reference"},
            {"kind": "focus", "targets": ["second"], "offset_ms": 13000, "duration_ms": 1000}
          ],
          "duration_ms": 18000
        },
        {
          "id": "duplicate-answer",
          "narration": "Assume A and B target the same row with distinct references, A wins the lock and commits, and both operations succeed. The inspected duplicate-worker test asserts that both READ COMMITTED locked calls return the same rejected sale: the waiting reload sees the committed rejection, not its old candidate. B is no longer due and writes nothing. Inferring through expire_one, A’s reference differs from B’s, so B does not count a new expiry. The source test does not fix the winner; this ordering is illustrative, not captured.",
          "claim_ids": [
            "duplicate-result",
            "attempt-attribution"
          ],
          "actions": [
            {
              "kind": "annotate",
              "targets": [
                "second",
                "sale"
              ],
              "offset_ms": 0,
              "duration_ms": 600,
              "text": "returned reference A ≠ attempt reference B → not newly expired"
            },
            {"kind": "acquire", "targets": ["tx", "row"], "offset_ms": 1500, "duration_ms": 1000, "resource": "row", "transaction": "tx", "illustrative": true},
            {"kind": "wait", "targets": ["second"], "offset_ms": 3500, "duration_ms": 2500, "illustrative": true, "reason": "B waits for A in this assumed ordering"},
            {"kind": "commit", "targets": ["tx"], "offset_ms": 6500, "duration_ms": 1000, "transaction": "tx", "illustrative": true},
            {"kind": "call", "targets": ["second", "row"], "offset_ms": 9500, "duration_ms": 1000, "illustrative": true, "source": "second", "destination": "row", "label": "Assumed A-wins ordering: B reloads committed rejection"},
            {"kind": "annotate", "targets": ["second", "sale"], "offset_ms": 14000, "duration_ms": 1000, "text": "B returns unchanged; A reference does not match B"}
          ],
          "duration_ms": 18000
        }
      ],
      "check": {
        "id": "predict-duplicate",
        "placement": "before",
        "prompt": "Assume A commits rejection first and B then reloads the same row with a distinct reference. Judge the claim: B counts this as newly expired because the returned sale has a reversal.",
        "objective_ids": [
          "duplicate"
        ],
        "explanation": "No. The locked recheck makes B a no-op, and expire_one compares the stored reversal reference with its own fresh reference.",
        "reveal_target": {
          "kind": "beat",
          "beat_id": "duplicate-answer"
        },
        "answer": {
          "kind": "choice",
          "options": [
            {
              "id": "counted",
              "label": "Counted: any reversal is enough"
            },
            {
              "id": "not-counted",
              "label": "Not counted: the reversal belongs to A’s reference"
            }
          ],
          "correct_option_id": "not-counted"
        }
      }
    }
  ],
