  "claims": [
    {
      "id": "paged-scan",
      "text": "expire_due scans AutoReject pages of 100 for one organisation; records::due filters non-null acceptance_due_at <= now, orders by deadline and purchase ID, and uses an exclusive tuple cursor. Per-order failures are collected; a page failure returns an error.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "scan",
        "store-due",
        "query"
      ]
    },
    {
      "id": "locked-reload",
      "text": "expire_unaccepted begins a READ COMMITTED transaction and calls records::load with exclusive=true. The loader selects the organisation/purchase row FOR UPDATE, not SKIP LOCKED.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "transaction",
        "load"
      ]
    },
    {
      "id": "concrete-boundary",
      "text": "PurchaseStore is a concrete PgPool-owning struct; this path calls records functions and Sale methods rather than a discovered storage trait.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "store",
        "transaction",
        "coordinator"
      ]
    },
    {
      "id": "recheck",
      "text": "The locked snapshot is admitted only when Sale::due_work(now).auto_reject is true. Otherwise reverse_locked commits and returns the previous sale without writes.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "transaction",
        "coordinator",
        "eligibility"
      ]
    },
    {
      "id": "inclusive-deadline",
      "text": "Auto-reject requires order timing, AwaitingAcceptance and an explicit reached acceptance deadline, using now >= deadline. Inspection does not advance state.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "eligibility"
      ]
    },
    {
      "id": "rejection",
      "text": "reject_expired refuses a first not-yet-due rejection; reject_with records OrderRejected with AcceptanceDeadline cause, reverses the sale, and sets fulfilment to Rejected.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "reject",
        "reject-with"
      ]
    },
    {
      "id": "reversal-effects",
      "text": "Sale::reverse returns optional restored wallet and reversed points snapshots, records credit/discount/points effects and accountable owner/reference, and creates a card refund only when card_remaining is nonzero.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "reverse",
        "reversal"
      ]
    },
    {
      "id": "pending-not-paid",
      "text": "new_refund creates Pending with no resolved_at. RefundStatus distinguishes Pending from Final. The reversal refund is an immutable request, not a current provider outcome; recording it does not execute an external refund.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "refund",
        "refund-status",
        "reversal",
        "coordinator"
      ]
    },
    {
      "id": "atomic-writes",
      "text": "reverse_locked validates discount/payment, obtains applicable wallet/points locks, applies the domain transition, releases consumed discounts, persists applicable wallet/points changes and the sale snapshot/projections, then commits the same SQL transaction. An unchanged version commits without writes.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "coordinator",
        "credit-lock",
        "points-write",
        "persist"
      ]
    },
    {
      "id": "attempt-attribution",
      "text": "expire_one generates a fresh random 128-bit refund reference and counts success only when the returned reversal reference equals that attempt reference. Finding any prior reversal is insufficient.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "attempt",
        "scan"
      ]
    },
    {
      "id": "duplicate-result",
      "text": "The concurrent and sequential retry source tests assert that distinct-reference expiry calls return the same rejected sale with one Pending refund. Assuming A wins this authored ordering and both calls succeed, B reloads A's committed rejection under the configured READ COMMITTED transaction and changes nothing. B not counting that result is inferred from expire_one's attempt-reference comparison; this is not an observed run or a claim about which worker wins.",
      "status": "implemented",
      "basis": "inference",
      "evidence_ids": [
        "load",
        "transaction",
        "coordinator",
        "eligibility",
        "attempt",
        "duplicate-test",
        "retry-test"
      ]
    },
    {
      "id": "race-tests",
      "text": "The source tests deliberately queue acceptance and expiry behind a row blocker. Acceptance-first uses acceptance time 9 and expiry time 10 and preserves acceptance; expiry-first preserves rejection with one Pending refund and refuses waiting acceptance. These tests were inspected, not executed here.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "race-helper",
        "accept-first-test",
        "expiry-first-test"
      ]
    },
    {
      "id": "deadline-acceptance",
      "text": "For an order still AwaitingAcceptance at exactly its acceptance deadline, check_progress refuses first acceptance because due_work(now).auto_reject is already true. Earlier recorded progress can be replayed; this is not a successful HTTP-request claim.",
      "status": "implemented",
      "basis": "source",
      "evidence_ids": [
        "accept",
        "eligibility",
        "deadline-test"
      ]
    }
  ],
