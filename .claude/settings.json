{
  "env": {
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "ECC_GATEGUARD": "off"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "voice-lint --hook",
            "if": "Bash(gh *)",
            "statusMessage": "Checking voice"
          },
          {
            "type": "command",
            "command": "pr-template-check --hook",
            "if": "Bash(gh pr create *)",
            "statusMessage": "Checking PR template"
          },
          {
            "type": "command",
            "command": "pr-template-check --hook",
            "if": "Bash(gh pr edit *)",
            "statusMessage": "Checking PR template"
          },
          {
            "type": "command",
            "command": "voice-lint --hook",
            "if": "Bash(jj describe *)",
            "statusMessage": "Checking voice"
          },
          {
            "type": "command",
            "command": "voice-lint --hook",
            "if": "Bash(jj commit *)",
            "statusMessage": "Checking voice"
          },
          {
            "type": "command",
            "command": "voice-lint --hook",
            "if": "Bash(git commit *)",
            "statusMessage": "Checking voice"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "ecc@ecc": true,
    "ralph-loop@claude-plugins-official": true,
    "sentry-cli@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "fallow-skills": {
      "source": {
        "source": "github",
        "repo": "fallow-rs/fallow-skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "directory",
        "path": "/home/jacob/Documents/Developer/i-have-adhd"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
