!.claude/settings.local.json

# Per-machine credentials and IDs — never shareable
.config/gh/
.config/graphite/user_config
.gitconfig.local
.config/ghostty/config.local

# Per-machine because the tool has no OS conditional
.config/direnv/direnv.toml

# .codex is ignored globally (gitignore_global) for project repos; here it's the point
!.codex/
# ...except config.toml: codex rewrites it constantly (marketplaces, hooks.state,
# TUI counters) and it holds linux-only MCP servers with no OS conditional.
.codex/config.toml

# Machine-generated / local state
.config/jj/repos
.config/fish/fish_variables
.config/zed/conversations
.config/zed/prompts
.config/zed/settings_backup.json
.config/raycast/extensions/

# Kiro CLI local state and generated projections
.kiro/logs/
.kiro/session-index/
.kiro/sessions/
.kiro/skills/
.kiro/settings/feed_state.json
.kiro/settings/mcp.json
.kiro/settings/survey_state.json
.kiro/agents/agent_config.json.example

# Claude Code local session state
.claude/projects/
.claude/sessions/
.claude/session-data/
.claude/session-env/
.claude/shell-snapshots/
.claude/paste-cache/
.claude/plans/
.claude/metrics/
.claude/history.jsonl
.claude/*-cache.json
.claude/policy-limits.json
.claude/remote-settings.json

# Editor/tool backups
*.bak
*.bak-*
*.orig
*.pre-*-sync
*.pre-numen-sync

# Python bytecode
__pycache__/
*.pyc
