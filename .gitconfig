[core]
	excludesFile = ~/.gitignore_global
	hooksPath = ~/.codex/git-hooks
	ignorecase = false
[user]
	email = jacob@jacobdevelops.com
	name = Jacob Sanderson
[gpg]
	format = ssh
[commit]
	gpgsign = true
[http]
	postBuffer = 524288000
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[safe]
	directory = /nix/store/qm8jb5pnbriakjvgh59qc4517ag6h26m-flutter-3.44.1
	directory = /nix/store/cyq880l2h6zyv8k5f803hxvp3pwjvz5i-flutter-3.44.1
	directory = ~/nix/store/r8ldxky17qndqakjm9bc8qcvs1p53aph-flutter-3.44.1
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Per-machine: signing key, coderabbit machineId. Untracked; see README.
[include]
	path = ~/.gitconfig.local
