#!/usr/bin/env bash
# voice-lint checks a small set of mechanical publishing policies.
# It cannot establish authorship, assess voice, or decide whether a reader has
# enough context. The write-as-jacob skill covers those editorial judgments.
#
#   voice-lint --mode comment reply.txt     # lint a file (or stdin with -)
#   voice-lint --hook                       # stdin = PreToolUse JSON; exit 2 blocks
#
# Modes: comment (review replies, issue comments) | pr (PR bodies) | commit |
# doc (harness docs: em dashes only).
# No prose word cap: useful context is not a lint violation (F163/F1218).
set -euo pipefail

MODE=comment
HOOK=0
FILE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --mode) MODE=$2; shift 2 ;;
    --hook) HOOK=1; shift ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) FILE=$1; shift ;;
  esac
done

TEXT=""
if [[ $HOOK == 1 ]]; then
  CMD=$(jq -r '.tool_input.command // empty' 2>/dev/null || true)
  [[ -z $CMD ]] && exit 0
  # Same command-position guard as pr-template-check: don't lint a payload that
  # merely quotes one of these commands.
  grep -qE '(^|[;&|]|&&|\|\||\bthen[[:space:]])[[:space:]]*(gh|jj|git)[[:space:]]' <<<"$CMD" || exit 0
  case $CMD in
    *"gh pr create"*|*"gh pr edit"*)                         MODE=pr ;;
    *"gh pr comment"*|*"gh pr review"*|*"gh issue comment"*) MODE=comment ;;
    *replies*)                                               MODE=comment ;;
    *"jj describe"*|*"jj commit"*|*"git commit"*)            MODE=commit ;;
    *) exit 0 ;;
  esac
  # Body comes from a file (--body-file X, -F body=@X) or inline (-m '...').
  if [[ $CMD =~ --body-file[[:space:]]+\"?([^[:space:]\"\']+) ]]; then
    F=${BASH_REMATCH[1]}
  elif [[ $CMD =~ (-F|--field)[[:space:]]+\"?body=@([^[:space:]\"\']+) ]]; then
    F=${BASH_REMATCH[2]}
  else
    F=""
  fi
  if [[ -n $F && $F != "-" && -f $F ]]; then
    TEXT=$(cat "$F")
  elif [[ $CMD =~ (--body|--message|-b|-m)[[:space:]]+\'([^\']*)\' ]]; then
    TEXT=${BASH_REMATCH[2]}
  elif [[ $CMD =~ (--body|--message|-b|-m)[[:space:]]+\"([^\"]*)\" ]]; then
    TEXT=${BASH_REMATCH[2]}
  fi
  # Nothing extractable (heredoc, stdin, --fill) — never block on a guess.
  [[ -z $TEXT ]] && exit 0
else
  if [[ -z $FILE || $FILE == "-" ]]; then TEXT=$(cat); else TEXT=$(cat "$FILE"); fi
fi

# Ignore commented-out template guidance when examining published content.
LIVE=$(printf '%s\n' "$TEXT" | perl -0777 -pe 's/<!--.*?-->//gs')

FAIL=()
if [[ $MODE != doc ]]; then
# Gate only stock phrases that are near-absent from his own baseline (<=1 in ~8k
# items); "good catch", "feel free", "happy to" occur and stay legal.
CEREMONY='\bas an ai\b|\bi understand your concern\b|\byou.?re absolutely right\b|\blet me know if\b|\bhope this helps\b|\bgreat question\b|\bi appreciate\b|\bin summary\b|\bto summari[sz]e\b|\bit.?s worth noting\b'
HITS=$(grep -inE "$CEREMONY" <<<"$LIVE" | head -4 || true)
[[ -n $HITS ]] && FAIL+=("Ceremony/LLM tells, remove stock phrasing: $(tr '\n' ';' <<<"$HITS")")
# Bloat guards only: far above his own upper tail, so they never force an
# under-informed draft (F163) but still stop essays (F378, F1229).
case $MODE in pr) CAP=800 ;; comment) CAP=120 ;; *) CAP=0 ;; esac
PROSE=$(awk '/^[[:space:]]*(```|~~~)/{f=!f;next} !f' <<<"$LIVE" | grep -vE '^[[:space:]]*(- \[[ xX]\]|#{1,6} |>)' || true)
WORDS=$(wc -w <<<"$PROSE")
(( CAP > 0 && WORDS > CAP )) && FAIL+=("$WORDS words in a $MODE is an essay, not something he'd write; cut what the reader already has, keep the point and its reason.")
# F163 explicitly requests removing the authorship trailer. Keep this separate
# from ordinary mentions of agents or tools in a technical explanation.
# F163's actual footer was "Claude Opus via omp." Match signature-shaped whole
# lines only; technical explanations and quoted/fenced examples aren't trailers.
UNFENCED=$(awk '
  /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
  !fence { print }
' <<<"$LIVE")
AUTHOR='(\[)?(claude([[:space:]]+(code|opus|sonnet|haiku|[0-9.]+))*|omp|codex|chatgpt|an? (ai|agent))(\]\([^)]*\))?'
ATTRIBUTION="^[[:space:]_*]*(🤖[[:space:]]*)?(co-authored-by:[[:space:]].+|(generated|written|authored) (with|by)[[:space:]]+${AUTHOR}|${AUTHOR}[[:space:]]+via[[:space:]]+omp)[.![:space:]_*]*$"
MODEL_SIGNATURE='^[[:space:]_*]*[A-Z][[:alnum:]._-]*([[:space:]]+[[:alnum:]][[:alnum:]._-]*){0,5}[[:space:]]+via[[:space:]]+omp[.![:space:]_*]*$'
HITS=$({ grep -inE "$ATTRIBUTION" <<<"$UNFENCED" || true; grep -nE "$MODEL_SIGNATURE" <<<"$UNFENCED" || true; } | head -3 || true)
[[ -n $HITS ]] && FAIL+=("Agent authorship trailer/footer. Remove the attribution: $(tr '\n' ';' <<<"$HITS")")
fi

# Profile: Vocabulary, sentence shapes and punctuation, Dashes: zero em dashes
# in 3,678 baseline inline/reply items, one in conversation comments. This is a
# mechanical policy, not proof of agent authorship. En dashes/emoji are allowed.
grep -qF '—' <<<"$LIVE" \
  && FAIL+=("Em dash. Use a comma, full stop, or brackets.")

if [[ $MODE == pr ]]; then
  # F993/F83 reject routine local CI recount; F390 still requires explained
  # proof. Match standalone check/status statements, not a whole line merely
  # containing "test", "ran" or a percentage (benchmarks and repros are valid).
  CHECK='(tests?|((full|ci) )?test suite|suite|checks?|ci( checks)?|lint|clippy|typecheck|type-?check|tsc|mypy|ruff|biome|eslint|rustfmt|fmt|pytest|coverage|((bun|npm|pnpm|yarn|cargo|go) (run )?(test|check|lint|clippy|fmt|typecheck)))'
  CHECKS="(all )?\`?${CHECK}\`?([[:space:]]*(,|and|&)[[:space:]]*\`?${CHECK}\`?)*"
  STATUS='(pass(es|ing|ed)?|green|clean|succeed(s|ed)?|[0-9]+([.][0-9]+)?%|[0-9]+ pass(ed)?([,;] [0-9]+ fail(ed)?)?)'
  PREFIX='^[[:space:]]*([-*][[:space:]]+)?((validation|verification|verified|testing|checks|tests|coverage):[[:space:]]*)?'
  RESULT="${CHECKS}[[:space:]:]+(are |is |all )?${STATUS}([[:space:]]+locally)?"
  COUNTS='[0-9]+ pass(ed)?[,;][[:space:]]+[0-9]+ fail(ed)?'
  RUN="(i[[:space:]]+)?(ran|run)[[:space:]]+(the[[:space:]]+)?${CHECKS}([[:space:]]+locally)?(:[[:space:]]+(all[[:space:]]+)?${STATUS})?"
  RECOUNT="${PREFIX}(${RESULT}([[:space:]]*(,|and|&)[[:space:]]*${RESULT})*|${RUN}|verified[[:space:]]+with[[:space:]]+${CHECKS}|${COUNTS})[.![:space:]]*$"
  HITS=$(grep -inE "$RECOUNT" <<<"$UNFENCED" | head -3 || true)
  [[ -n $HITS ]] && FAIL+=("Recounts what CI already shows (test/lint/coverage results). Remove routine check status; keep material benchmarks, reproductions and manual evidence: $(tr '\n' ';' <<<"$HITS")")
fi

if [[ $MODE == pr || $MODE == comment ]]; then
  # Rendering policy from 787227b05ffd, not an authenticated voice trait.
  # Reject long prose lines continued without a paragraph break; keep fenced
  # examples and deliberately short breaks.
  WRAPPED=$(awk '
    /^\s*```/ { fence = !fence; prev = ""; next }
    fence { next }
    /^[[:space:]]*$/ { prev = ""; next }
    {
      cur = $0
      isprose = (cur !~ /^[[:space:]]*([-*+>|]|[0-9]+[.)]|#{1,6} |<)/)
      if (prev != "" && isprose && length(prev) >= 60) { print NR; exit }
      prev = (isprose || cur ~ /^[[:space:]]*([-*+]|[0-9]+[.)]) /) ? cur : ""
    }
  ' <<<"$LIVE" || true)
  [[ -n $WRAPPED ]] && FAIL+=("Hard-wrapped prose (line $WRAPPED). GitHub renders the newline as a break. One paragraph = one line.")
fi

if [[ $MODE == commit ]]; then
  # Explicit project publishing policy, not an empirical authorship test.
  # Profile: Commit subjects documents historical bodies as counterexamples.
  # Only the first line can identify a generated merge. Its standard body is
  # exempt, but attribution and em-dash findings above still block publishing.
  if ! grep -qE '^Merge (branch|remote-tracking branch|pull request) ' <<<"${TEXT%%$'\n'*}"; then
    (( $(grep -c '[^[:space:]]' <<<"$TEXT" || true) > 1 )) \
      && FAIL+=("Commit body. Subject line only, drop everything after the first line.")
  fi
  # Messages that describe the occasion instead of the change.
  VAGUE='(implement|address|appl|resolv|incorporat)[a-z]* (the )?((pr|code) )?(review )?(feedback|comments?|review)|as requested|^[a-z]+(\([^)]*\))?!?: *(various|misc|minor|small|assorted|general)\b|^[a-z]+(\([^)]*\))?!?: *(bug ?fixes|fixes|updates?|changes|improvements?|cleanup|tweaks?|refactor(ing)?|lint(ing)?( fixes)?)[[:space:]]*$'
  grep -qiE "$VAGUE" <<<"$TEXT" \
    && FAIL+=("Says nothing about what changed. Name the thing you touched and what happened to it.")
fi

if (( ${#FAIL[@]} )); then
  { echo "voice-lint ($MODE): rewrite before sending."
    printf ' - %s\n' "${FAIL[@]}"
    echo "Rules: the write-as-jacob skill. Passing lint does not establish voice or sufficient context."
  } >&2
  exit 2
fi
exit 0
