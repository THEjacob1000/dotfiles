#!/usr/bin/env bash
# Every agent reaches ripwire through this front, so a legend-free answer is a guarantee
# rather than a flag each skill has to remember: even the compact legend is ~0.5-1.2 KB
# of identical prose per call, re-read on every later turn. --legend=full passes through.
set -euo pipefail

real="${RIPWIRE_REAL:-$HOME/.local/share/ripwire/bin/ripwire}"
if [ ! -x "$real" ]; then
  echo "ripwire: no binary at $real (run: mise run install-ripwire)" >&2
  exit 127
fi

[ $# -eq 0 ] && exec "$real"

holds_repos() {
  local marker
  for marker in "$1"/*/.git "$1"/*/.jj; do
    if [ -e "$marker" ] || [ -L "$marker" ]; then
      return 0
    fi
  done
  return 1
}

for arg in "$@"; do
  if [ "$arg" = --mcp ] && command -v systemd-run >/dev/null &&
    systemd-run --user --scope --quiet true 2>/dev/null; then
    # The server keeps every index it builds for the whole session; a cgroup cap kills it instead of the machine.
    exec systemd-run --user --scope --quiet -p MemoryMax=4G -p MemorySwapMax=0 "$real" "$@"
  fi
  case "$arg" in -*) continue ;; esac
  if [ -d "$arg" ] && ! git -C "$arg" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
    holds_repos "$arg"; then
    echo "ripwire: $arg holds several repos; root it at one checkout (or list 2..16 of them), or use rg across the tree" >&2
    exit 2
  fi
done

for arg in "$@"; do
  case "$arg" in
    --legend|--legend=*|--json|--mcp|--mcp-*|--help|-h|--version|--help-task|--help-task=*|\
    --situ|--situ=*|--recall|--recall=*|--report|--report=*|--mermaid|--mermaid=*|--html|--html=*|\
    --plan-lanes|--plan-lanes=*|--sarif|--sarif=*|--eval*|\
    --replace-symbol-body=*|--insert-before-symbol=*|--insert-after-symbol=*|--edit-plan=*|\
    --note-add=*|--quality-baseline|--quality-ack|--quality-ack=*|--index-out=*|--export=*)
      exec "$real" "$@" ;;
  esac
done

out="$(mktemp)"
err="$(mktemp)"
trap 'rm -f "$out" "$err"' EXIT
set +e
"$real" "$@" --legend=compact >"$out" 2>"$err"
rc=$?
set -e
if [ "$rc" -ne 0 ] && grep -q -- '--legend=compact applies to the XML verbs only' "$err"; then
  # A consumed pipe cannot be replayed, so a piped prose verb must name its legend itself.
  if [ -t 0 ] || [ /dev/stdin -ef /dev/null ]; then
    rm -f "$out" "$err"
    exec "$real" "$@"
  fi
  echo "ripwire: this verb takes no legend; rerun with --legend=full when piping stdin" >&2
fi
perl -0777 -pe 's/\A<!-- ripwire .*?-->\n?//s' "$out"
cat "$err" >&2
exit "$rc"
